# ---- Backend ----------------------------------------------------------------
# Default: official hosted Nuvio API. For self-host use e.g. https://nuvio.example.com
NUVIO_BACKEND_URL=https://api.nuvio.tv
# Public publishable key (safe to share).
NUVIO_PUBLISHABLE_KEY=sb_publishable_1Clq8rlTVACkdcZuqr6_AD__xUUC_EN

# ---- Auth to Nuvio ----------------------------------------------------------
NUVIO_EMAIL=
NUVIO_PASSWORD=
# Alternative: a long-lived refresh token instead of email/password.
# NUVIO_REFRESH_TOKEN=
NUVIO_ORIGIN_CLIENT_ID=nuvio-mcp

# ---- Storage ----------------------------------------------------------------
# Base dir for session/snapshots/audit. Default: ~/.local/share/nuvio-mcp
# NUVIO_DATA_DIR=
# NUVIO_SESSION_FILE=
# NUVIO_SNAPSHOT_DIR=
# NUVIO_AUDIT_FILE=
# Secret used to sign two-phase confirmation tokens. Set a stable 32+ char value
# for multi-instance deployments; otherwise a per-process random secret is used.
# NUVIO_CONFIRM_SECRET=
# When true, no snapshots are written and reversible changes cannot be undone.
# NUVIO_DISABLE_SNAPSHOTS=false

# ---- Transport --------------------------------------------------------------
# stdio (default) or http (modern, stateless Streamable HTTP MCP server)
NUVIO_TRANSPORT=stdio
# Timeout for outbound requests to the Nuvio backend (ms).
# NUVIO_BACKEND_TIMEOUT_MS=30000
# HTTP only:
NUVIO_HTTP_HOST=127.0.0.1
NUVIO_HTTP_PORT=3333
# Static bearer token. Required unless binding loopback or using OAuth introspection.
NUVIO_HTTP_TOKEN=
# Host header allowlist (DNS-rebinding protection). Required for a public hostname.
# NUVIO_HTTP_ALLOWED_HOSTS=mcp.example.com
# Comma separated allowed CORS origins. Empty disables cross-origin access.
# NUVIO_HTTP_CORS=https://your-app.example
# Limits.
# NUVIO_HTTP_MAX_BODY_BYTES=1048576
# NUVIO_HTTP_MAX_CONCURRENCY=64
# NUVIO_HTTP_REQUEST_TIMEOUT_MS=120000
# Refuse to start a non-loopback endpoint without auth unless you set this (unsafe).
# NUVIO_HTTP_ALLOW_UNAUTHENTICATED=false

# ---- OAuth resource server (optional, for standard remote MCP clients) ------
# When set, RFC 9728 protected-resource metadata is served and the token is
# verified via RFC 7662 introspection.
# NUVIO_OAUTH_ISSUER=https://auth.example.com
# NUVIO_OAUTH_INTROSPECTION_URL=https://auth.example.com/oauth/introspect
# NUVIO_OAUTH_CLIENT_ID=
# NUVIO_OAUTH_CLIENT_SECRET=
# NUVIO_OAUTH_SCOPES=mcp
